--!strict
return function(test: (string, () -> ()) -> ())
	test("reel previews distinguish repeated symbols at different starting slots", function()
		local L = require("../../src/shared/Util/Locale")
		local first = L.text(
			"REELS.PREVIEW_STRIP",
			{ reel = 1, slot = 1, offset = "STAR", symbols = "STAR STAR CANDY" }
		)
		local second = L.text(
			"REELS.PREVIEW_STRIP",
			{ reel = 1, slot = 2, offset = "STAR", symbols = "STAR STAR CANDY" }
		)
		assert(first ~= second, "players must see which repeated symbol is the starting slot")
	end)
	test("packets reject nested data, long field names, oversized strings and excess fields", function()
		local I = require("../../src/shared/Logic/InputRules")
		assert(I.packet({ kind = "throw", seq = 1, aim = 0, power = 0.5, spin = 1 }))
		assert(not I.packet({ nested = {} }) and not I.packet({ value = math.huge }), "scalar finite fields")
		assert(not I.packet({ [string.rep("x", 65)] = true }), "bounded field name")
		assert(not I.packet({ kind = string.rep("x", 65) }), "bounded value")
		assert(not I.packet({ a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9 }), "field limit")
	end)
	test("quota scales by locked crew and difficulty with nice rounding", function()
		local Q = require("../../src/shared/Logic/Quota")
		assert(Q.calculate(1, 1, "Normal") == 260, "solo quota")
		assert(Q.calculate(1, 4, "Normal") == 620, "four player quota")
		assert(Q.calculate(3, 3, "Hard") == 2730, "hard crew quota")
		assert(Q.calculate(13, 2, "Normal") == 256500, "endless growth")
		assert(Q.roundNice(9999) == 10000 and Q.roundNice(10049) == 10000, "rounding boundary")
	end)
	test("stake validates integers, limits and shared balance", function()
		local S = require("../../src/shared/Logic/Stakes")
		for _, amount in { -1, 0, 9, 10.5, 1001, math.huge, 0 / 0 } do
			assert(not S.valid(amount, 1000, 1, false), "invalid stake")
		end
		assert(S.valid(10, 10, 1, false), "last minimum")
		assert(not S.valid(11, 10, 1, false), "overdraft")
		assert(S.valid(100, 1000, 1, true) and not S.valid(101, 1000, 1, true), "rookie cap")
	end)
	test("big stake requires both strict thresholds", function()
		local S = require("../../src/shared/Logic/Stakes")
		assert(not S.big(300, 1000, 1) and S.big(301, 1000, 1), "thirty percent is not big")
		assert(not S.big(100, 200, 1) and S.big(101, 200, 1), "ten minima is not big")
	end)
	test("approval uses responders; silence and ties approve", function()
		local A = require("../../src/shared/Logic/Approval")
		assert(not A.blocked(true, {}), "silence")
		assert(not A.blocked(true, { true, false }), "tie")
		assert(A.blocked(true, { false, true, false }), "responding majority")
		assert(not A.blocked(false, { false, false }), "friends drama only")
	end)
	test("payout floors Tickets and bounds all multipliers", function()
		local P = require("../../src/shared/Logic/Payout")
		assert(P.tickets(11, 1.2, 10) == 13, "floor fractional Tickets")
		assert(P.tickets(100, 20, 10) == 1000, "sanity cap")
		assert(P.tickets(100, 0, 10) == 0, "loss")
	end)
	test("ledger rejects overdrafts and duplicate operations atomically", function()
		local J = require("../../src/shared/Logic/JarLedger")
		local jar = J.new(1000)
		assert(J.change(jar, -700, "STAKE", "a", 1, 0), "first stake")
		assert(not J.change(jar, -700, "STAKE", "b", 2, 0), "concurrent stake rejected")
		assert(J.change(jar, 1400, "BOOTH_PAYOUT", "pay-a", 1, 1), "payout")
		assert(not J.change(jar, 1400, "BOOTH_PAYOUT", "pay-a", 1, 1), "duplicate payout")
		assert(jar.balance == 1700 and #jar.audit == 2, "balance and audit agree")
		assert(jar.audit[2].before == 300 and jar.audit[2].after == 1700, "audit snapshots")
	end)
	test("ledger rejects non-finite amounts and caps large payouts", function()
		local J = require("../../src/shared/Logic/JarLedger")
		local jar = J.new(1000)
		assert(not J.change(jar, 0 / 0, "DEV", "nan", 1, 0), "NaN")
		assert(not J.change(jar, math.huge, "DEV", "inf", 1, 0), "infinity")
		assert(J.change(jar, 9999999999, "BOOTH_PAYOUT", "cap", 1, 0), "capped payout")
		assert(jar.balance == 9999999999 and jar.audit[1].delta == 9999998999, "audit actual credited amount")
	end)
	test("timing rejects stale, future and duplicate sequences", function()
		local I = require("../../src/shared/Logic/InputRules")
		assert(I.timestamp(9.7, 10, 0.1, 9), "allowed latency")
		assert(not I.timestamp(9.6, 10, 0.1, 9), "stale")
		assert(not I.timestamp(10.06, 10, 0, 9), "future")
		assert(not I.timestamp(9.5, 10, 1, 9.6), "time reversal")
		assert(I.sequence(2, 1) and not I.sequence(1, 1), "replay sequence")
		assert(not I.finite(0 / 0) and not I.finite(math.huge), "invalid numeric payload")
	end)
	test("reels advance by timeline and pay exact matches", function()
		local R = require("../../src/shared/Logic/BoothLogic/Reels")
		assert(R.position(0, 1, 1, 1) == 6, "F1 speed")
		assert(math.abs(R.position(0, 3, 1, 1.5) - 13.5) < 0.000001, "wobble integrates over a cycle")
		assert(R.symbol({ "A", "B", "C" }, 0, 1, 1, 0.2) == "B", "center symbol")
		assert(R.multiplier({ "WADDLES", "WADDLES", "WADDLES" }) == 10, "triple Waddles")
		assert(R.multiplier({ "STAR", "STAR", "STAR" }) == 5, "triple Star")
		assert(R.multiplier({ "CANDY", "CANDY", "CANDY" }) == 3, "triple")
		assert(R.multiplier({ "STAR", "CANDY", "STAR" }) == 1.2, "pair any order")
		assert(R.multiplier({ "STAR", "CANDY", "TICKET" }) == 0, "no match")
	end)
	test("block opening outcomes and point phase follow the table", function()
		local B = require("../../src/shared/Logic/BoothLogic/BlockToss")
		assert(B.result(7, nil, 0).multiplier == 2 and B.result(11, nil, 0).multiplier == 2, "opening win")
		for _, total in { 2, 3, 12 } do
			assert(B.result(total, nil, 0).multiplier == 0, "opening loss")
		end
		assert(B.result(4, nil, 0).point == 4, "establish point")
		assert(B.result(4, 4, 1).multiplier == 2.5, "hard point")
		assert(B.result(8, 8, 1).multiplier == 2, "normal point")
		assert(B.result(7, 8, 1).multiplier == 0, "seven out")
		assert(B.result(6, 8, 9).multiplier == nil, "continue point")
		assert(B.result(6, 8, 10).multiplier == 1, "ten toss tie")
		assert(B.result(8, 8, 10).multiplier == 2, "winning tenth toss beats tie")
	end)
	test("pie setup protects chosen opening and computes real neighbors", function()
		local P = require("../../src/shared/Logic/BoothLogic/PieSweeper")
		local order = {}
		for i = 1, 25 do
			table.insert(order, i)
		end
		local board = P.create(3, 13, order)
		assert(not board.pies[13] and not board.pies[7] and not board.pies[19], "opening area protected")
		local count = 0
		for _ in board.pies do
			count += 1
		end
		assert(count == 3 and P.neighborCount(board, 6) == 2, "pie count and edge neighbors")
		assert(P.neighborCount(board, 13) == 0, "opening zero")
	end)
	test("pie zero picks reveal exactly one tile and duplicate picks cannot pay twice", function()
		local P = require("../../src/shared/Logic/BoothLogic/PieSweeper")
		local order = {}
		for i = 1, 25 do
			table.insert(order, i)
		end
		local board = P.create(3, 13, order)
		local ok = P.reveal(board, 13)
		assert(ok and board.revealed[13] == 0 and board.safeCount == 1, "zero opening stays one tile")
		assert(board.revealed[12] == nil and board.revealed[14] == nil, "neighbors stay covered")
		assert(P.reveal(board, 14) and board.safeCount == 2, "next pick reveals only its tile")
		local before = board.safeCount
		assert(not P.reveal(board, 13) and board.safeCount == before, "duplicate reveal ignored")
		for tile in board.revealed do
			assert(not board.pies[tile], "only safe picks are recorded")
		end
		assert(not P.reveal(board, 1), "pie splat")
	end)
	test("pie pays reciprocal survival per chosen tile after the guaranteed opening", function()
		local P = require("../../src/shared/Logic/BoothLogic/PieSweeper")
		assert(P.multiplier(3, 1) == 1, "first safe tile")
		assert(P.multiplier(3, 2) == 1.14, "one extra uses remaining 24/21 without an edge factor")
		assert(P.multiplier(3, 3) == 1.31, "two extras use 24/21 times 23/20")
		assert(P.multiplier(8, 2) == 1.5 and P.multiplier(8, 3) == 2.3, "eight-pie per-pick payouts")
		assert(P.multiplier(8, 17) == 50, "ceiling")
		assert(P.multiplier(3, 6) > P.multiplier(3, 2), "extra deliberate picks grow payout")
	end)
	test("readiness cancels departure when majority leaves or unreadies", function()
		local R = require("../../src/shared/Logic/RunRules")
		assert(R.readyDelay(1, 1) == 3 and R.readyDelay(4, 4) == 5, "solo and all")
		assert(R.readyDelay(3, 4) == 60 and R.readyDelay(2, 4) == nil, "strict majority")
		assert(R.readyDelay(0, 0) == nil, "empty server")
		assert(R.tokens(100, 400) == 4 and R.tokens(10000, 400) == 7, "surplus tokens cap")
	end)
end
